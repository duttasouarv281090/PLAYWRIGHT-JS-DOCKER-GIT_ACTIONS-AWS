{
  "name": "playwright_e2e_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:report": "rimraf test-result reports && mkdirp test-result reports",
    "generate:report": "node ./scripts/reportGenerate.js",
    "pretest": "npm run clean:report",
    "executeScript": "cucumber-js",
    "postexecuteScript": "npm run generate:report",
    "test": " npm run executeScript",
    "executeScript:failedcase": "cucumber-js -p rerun @rerun.txt",
    "test:failedtestcase": "npm run executeScript:failedcase && npm run generate:report",
    "test:withtags": "cucumber-js --tags=@test && npm run generate:report",
    "chrome": "cross-env BROWSER=chrome cucumber-js --parallel 2",
    "edge": "cross-env BROWSER=edge cucumber-js --parallel 2",
    "webkit": "cross-env BROWSER=webkit cucumber-js --parallel 2",
    "all:browsers": "npm-run-all --parallel chrome webkit",
    "all": "npm run clean:report && npm run all:browsers && npm run generate:report"

  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "cross-env": "^10.1.0",
    "mkdirp": "^3.0.1",
    "multiple-cucumber-html-reporter": "^4.3.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.83",
    "dotenv": "^17.4.2",
    "path": "^0.12.7"
  }
}
