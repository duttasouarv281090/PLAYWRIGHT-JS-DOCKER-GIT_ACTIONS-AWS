pipeline
{
    agent any
    stages
    {
            stage('Docker grid up')
            {
                steps
                {
                    bat  "docker compose up --build --abort-on-container-exit"
                }
            }
            stage('Copy Reports') {
            steps {
                bat 'docker cp playwright_docker:/app/reports reports'
            }
        }
          
    }
    post
    {
        always
        {
            archiveArtifacts artifacts: 'reports/**', followSymlinks: false
            bat "docker compose down"
        }
    }
}